msfpatch {
    Permadeath:
        // check PostBattle__Flags;
        // if first-time, run the permadeath code
        // and check for the Legend Sword as we go
        // -- then if there won't be a second time,
        // salvage the Legend Sword 
        // if second-time, then there must be spoils,
        // and we can now salvage the Legend Sword
        // if we need to
        lda $_PostBattle__Flags
        // can't have bit 2 w/o bit 1, so this saves
        // an instruction
        and #$03
        beq $+FirstTimePermadeath
        // check if the Legend Sword needs salvaging
        and #$02
        beq $+NoSalvagingNeeded
        jsr $_SalvageLegendSword
    %NoSalvagingNeeded:
        rtl

    %FirstTimePermadeath:
        // %flag characters_permadeader off%
        // don't do anything for "no gameover" battles
        lda $38e5
        and #$02
        beq $+DoPermadeath
        rtl
    %DoPermadeath:
        // %end%

        tdc
        tax
    %LoopStart:
        lda $1003,x

        // %flag characters_permadeader on%
        and #$C0  // check for swoon + stone
        // %end%
        // %flag characters_permadeader off%
        and #$80  // check for swoon
        // %end%

        beq $+Next
        // %anyflags: hero_challenge superhero_challenge %
        //  the Hero is exempt from permadeath
        lda $1000,x
        and #$1f
        cmp #$01
        beq $+Next
        // %end%

        stz $1000,x
        jsr $_CheckForLegendSword

    %Next:
        jsr $_Util__XPlus40
        cpx #$0140
        bcc $-LoopStart

        // do we need to salvage the Legend Sword?
        // if yes, do we do it now or later?
        lda $_PostBattle__Flags
        and #$02
        beq $+SkipSalvaging
        
        // if there are spoils, skip for now 
        // and we'll catch it in a different code branch,
        // otherwise salvage now
        lda $a8
        and #$10
        beq $+SkipSalvaging
        jsr $_SalvageLegendSword

    %SkipSalvaging:
        // change party leader if previous party leader permadied
        // switch D bank so we can borrow some bank 15 routines
        phd
        ldy #$0600
        phy
        pld

        jsl $15c881     // X = party leader slot * 0x40
        lda $1000,x
        bne $+PartyLeaderAlive

        jsl $=CyclePartyLeader
    %PartyLeaderAlive:
        pld
        rtl

    CheckForLegendSword:
        lda $1033,x
        cmp #$19
        bne $+CheckLeftHand
        // zero out the hand/count
        stz $1033,x
        stz $1034,x
        // jump forward to set the flag,
        // then return here to possibly
        // handle the left hand as well
        jsr $_SetSalvageFlag
    %CheckLeftHand:
        lda $1035,x
        cmp #$19
        bne $+DoneChecking
        // zero out the hand/count
        stz $1035,x
        stz $1036,x
    %SetSalvageFlag:
        // set the flag to salvage
        // the lost sword
        lda $_PostBattle__Flags
        ora #$02
        sta $_PostBattle__Flags
    %DoneChecking:
        rts

    SalvageLegendSword:
        // try to stuff Legend Sword in the inventory
        ldx #$0000
    %InventoryLoop:
        lda $1440,x
        bne $+InventoryNext
        lda #$19
        sta $1440,x
        lda #$01
        sta $1441,x
        rts
    %InventoryNext:
        inx
        inx
        cpx #$0060
        bcc $-InventoryLoop

        // if it didn't make it to the inventory, try to deliver as a battle item
        // we're only calling this function when there are no other spoils or
        // after we've already set spoils
        lda $06c6
        bne $+MIABSpoils
        ldx #$0000
    %SpoilsLoop:
        lda $1804,x
        bne $+SpoilsNext
    %FoundEmptySpoilsSlot:
        lda #$19
        sta $1804,x
        rts
    %SpoilsNext:
        inx
        cpx #$0007
        bcc $-SpoilsLoop
        // Override eighth item with Legend, it's important
        bra $-FoundEmptySpoilsSlot

    %MIABSpoils:
        // put the Legend Sword in the second spoils slot
        // and check it in Rewards__MIABContents
        lda #$19
        sta $1805
        rts
}
