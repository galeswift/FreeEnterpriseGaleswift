event($10)  //Opening events
{
    vfx 0 // wipe out latent CHR data

    // Initial game state
    set #OpeningComplete
    set #DamcyanBombed
    set #ReinforcedEnterprise
    set #ReinforcedFalcon

    // give the Hook for free; need to find the Drill
    set #Hook

    // disable "free" spots with no free lunch flag
    // (Damcyan needs special case handling in damcyan.f4c)
    [#B #Rando_CheckFlag #randoflag.no_free_characters]
    [#B #If #Flag #flag.Result] {
        deactivate #fe_WateryPassTellah
        deactivate #Elder1
        set #TellahRejoined
    }

    // disable non-"free" spots with only free characters flag
    // all others disabled in their respective .f4c file
    [#B #Rando_CheckFlag #randoflag.no_earned_characters]
    [#B #If #Flag #flag.Result] {
        deactivate #Edge1
        set #FusoyaJoined
    }

    [#B #Rando_CheckFlag #randoflag.no_free_key_item]
    [#B #If #Flag #flag.Result] {
        set #SpokeToEdwardInToroia
    }

    // %testmode%
    [#B #TestMode_Startup]
    // %end%
    // %test_setting characters%
    [#B #DebugFillShadowParty]
    // %end%

    // %flag characters_cecil_paladin on%
    set #CecilBecamePaladin
    [#B #Rando_PaladinizeCecil]    
    // %end%

    // %flags: superhero_challenge%
    [#B #MakeSuperhero]
    // %end%

    // %quickstart%
    [#B #Rando_DeliverRewardFromSlot #reward_slot.starting_partner_character]
    [#B #Rando_DeliverRewardFromSlot #reward_slot.starting_item]
    [#B #GiveStarterKit]
    music #Prologue
    load map #Underworld at 99 83 on falcon no transition no launch
    [#B #EndEvent]
    // %end%

    toggle music fade
    toggle screen fade

    consts(placement) {
        0   KingGiott1
        1   Luca1
        2   Dwarf19
        3   Dwarf20
        4   Dwarf21   
        5   Dwarf22
        6   Kain2
        11  Calbrena
    }
    load map #DwarfCastleThroneRoom at 10 15 facing up
    player invisible
    p #Luca1 toggle visible
    p #Calbrena toggle visible

    toggle screen fade
    pause 2
    player visible
    batch 4 {
        player move up
    }
    [#B #PlacementSetVisible 6]  // p #Kain2 toggle visible
    batch {
        player move up
        p #Kain2 move right
    }
    batch 3 {
        player move up
        p #Kain2 move up
    }
    pause 8
    batch 2 {
        p #Luca1 move down
    }
    pause 2
    batch {
        p #Luca1 face left
        player face right
    }
    pause 2
    message $1D  // From my father
    [#B #Text_LoadRewardNameFromSlot #reward_slot.starting_item 0]
    sound #GetItem
    message #msg.fe_Received
    [#B #Objectives_TickRewardSlot #reward_slot.starting_item]
    [#B #Rando_DeliverRewardFromSlot #reward_slot.starting_item]

    // %starterkit0 message enable%
    sound #GetItem
    message $A1
    // %end%
    // %starterkit1 message enable%
    sound #GetItem
    message $A2
    // %end%
    // %starterkit2 message enable%
    sound #GetItem
    message $A3
    // %end%
    // %starterkit3 message enable%
    sound #GetItem
    message $A5
    // %end%
    // %starterkit4 message enable%
    sound #GetItem
    message $A6
    // %end%
    [#B #GiveStarterKit]

    pause 2
    batch {
        player move down
        p #Luca1 face down
    }
    batch 1 {
        player face right
        p #Kain2 face left
    }
    pause 2


    // Has partner flag
    set #Temp

    [#B #Rando_CheckFlag #randoflag.no_starting_partner]    
    [#B #If #Flag #flag.Result] {
        clear #Temp
    }

    [#B #If #Flag #flag.Temp]
    {
        [#B #Text_LoadRewardNameFromSlot #reward_slot.starting_partner_character 0]
        map message 6 // Let's go!

        // %flags: Cparty:1 ~Cpermajoin%
        p #Kain2 toggle visible
        // %end%

        //TODO: restore? [#B #Objectives_TickRewardSlot #reward_slot.starting_partner_character]
        [#B #Rando_DeliverRewardFromSlot #reward_slot.starting_partner_character]
        pause 2
    }
        
    // %debug init%
    // %end%

    [#B #If #Flag #flag.Temp]
    {
        batch 1 {
            player bow head
            p #Kain2 bow head
        }
        pause 2
        batch 1 {
            player face down
            p #Kain2 face down
        }
        // %if wacky_challenge_enabled%
        music #FatChocobo
        // %else%
        music #Prologue
        // %end%
        batch {
            player move down
            p #Kain2 move left
        }
        batch 6 {
            player move down
            p #Kain2 move down
        }
    }

    [#B #If #not_Flag #flag.Temp]
    {
        player bow head
        pause 2
        player face down
        // %if wacky_challenge_enabled%
        music #FatChocobo
        // %else%
        music #Prologue
        // %end%
        batch {
            player move down
            p #Kain2 face down
        }
       batch 6 {
            player move down
        }
    }

    consts(placement) {
        0  Cid
        5  Kain
    }
    load map #DockedAirship at 25 8 facing left
    player face left
    [#B #If #not_PartySize 1] {
        batch {
            player move left
            p #Kain toggle visible
        }
    }
    [#B #If #PartySize 1] {
        player move left
    }

    batch {
        player move left
        p #Kain move left
    }
    batch {
        player move down
        p #Kain move left
    }
    batch {
        player move down
        p #Kain move down
    }
    batch {
        player move left
        p #Kain move down
    }
    batch 7 {
        player move left
        p #Kain move left
    }
    batch {
        player move down
        p #Kain move left
    }
    batch {
        player move left
        p #Kain move down
    }
    batch 2 {
        player move left
        p #Kain move left
    }
    batch 2 {
        player move down
        p #Kain move down
    }
    player move down
    pause 8
    player wave in
    pause 7
    sound #Earthquake
    pause 15

    sound $5E
    toggle screen shake
    pause 16
    //sound #None
    toggle screen shake

    vfx #Prologue

    toggle screen shake

    load map #Underworld at 99 83 on falcon no transition
    sound #None
    sound #None
    toggle screen shake

    // %if wacky_challenge_enabled%
    [#B #GotoEvent #event.fe_GuidingwayIntro]
    // %end%
}

placement($109 6)  //#DwarfCastleThroneRoom
{
    // %kain1_slot npc1%
    npc #fe_DynamicNPC
    // %end%
    position 10 11
}

// remove Yang from DockedAirship
placement($C3 1)
