}
// %end%

mapgrid($24 6 13) { 02 } // erase Cid greeting trigger in Castle Baron

// Erase Rosa conversation trigger
mapgrid($2D 2 6) { 01 }


// Remove "prologue complete" flag check from Cecil bedroom to save a flag
eventcall($05)
{
    $68   //Resting for free in Castle Baron
}

