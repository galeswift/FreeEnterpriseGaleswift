// Idea: when a character ends the battle swooned,
// then they get put back into the shadow party and
// end up at the Tower of Wishes... 

// if it's Cbrieflydead, then that's it, 
// but if it's Cmostlydead, then they're
// reinitialized to be at base level, as if you're
// getting them for the first time again.

// Cbye makes both flags permadeath, so.. that's that.

// hook into the same place that permadeath does,
// in post_battle.f4c. Otherwise, call the relevant functions.

// most of this code is a reskin of the
// updated permadeath.f4c code

msfpatch {
    SwoonToWishes:        
        // check PostBattle__Flags;
        // if first-time, run the swoon-to-wishes code
        // and check for the Legend Sword as we go
        // -- then if there won't be a second time,
        // salvage the Legend Sword 
        // if second-time, then there must be spoils,
        // and we can now salvage the Legend Sword
        // if we need to
        lda $_PostBattle__Flags
        // can't have bit 2 w/o bit 1, so this saves
        // an instruction
        and #$03
        beq $+DoSwoonToWishes
        // check if the Legend Sword needs salvaging
        and #$02
        beq $+NoSalvagingNeeded
        jsr $_SalvageLegendSword
    %NoSalvagingNeeded:
        rtl

        // don't do anything for "no gameover" battles
        lda $38e5
        and #$02
        beq $+DoSwoonToWishes
        rtl
        
    %DoSwoonToWishes:
        tdc
        tax
    %LoopStart:
        // check that the character isn't just residual data
        // because you can enter another battle after losing a
        // character, and the status field doesn't change.
        // (doesn't matter for permadeath, but does here)
        lda $1000,x
        beq $+Next

        lda $1003,x
        and #$80  // check for swoon

        beq $+Next
        // %anyflags: hero_challenge superhero_challenge%
        //  the Hero is exempt from being sent to the Tower
        lda $1000,x
        and #$1f
        cmp #$01
        beq $+Next
        // %end%

        // due to things like doors rando and starting underground,
        // always take the Legend Sword away
        jsr $_CheckForLegendSword

        lda $1000,x
        and #$1f
        
        // %flag characters_briefly_dead on%
        phx
        pha
        // subroutine expects X + 0x1000, and we can't
        // easily pass the slot number without using Y, etc.
        rep #$20
        .mx 0x00
        txa
        clc
        adc #$1000
        tax
        tdc
        sep #$20
        .mx 0x20
        pla
        jsr $_CharEx__PushPartySlotToShadowPartyAxtorKnown
        plx
        // %end%
        stz $1000,x
        // %flag characters_mostly_dead on%
        // don't push the characters; re-initialize!
        phx
        jsr $_CharEx__InitializeAxtor
        plx
        // %end%

    %Next:
        jsr $_Util__XPlus40
        cpx #$0140
        bcc $-LoopStart

        // do we need to salvage the Legend Sword?
        // if yes, do we do it now or later?
        lda $_PostBattle__Flags
        and #$02
        beq $+SkipSalvaging
        
        // if there are spoils, skip for now 
        // and we'll catch it in a different code branch,
        // otherwise salvage now
        lda $a8
        and #$10
        beq $+SkipSalvaging
        jsr $_SalvageLegendSword

    %SkipSalvaging:
        // change party leader if previous party leader left the party
        // switch D bank so we can borrow some bank 15 routines
        phd
        ldy #$0600
        phy
        pld

        jsl $15c881     // X = party leader slot * 0x40
        lda $1000,x
        bne $+PartyLeaderPresent

        jsl $=CyclePartyLeader
    %PartyLeaderPresent:
        pld
        rtl

    CheckForLegendSword:
        lda $1033,x
        cmp #$19
        bne $+CheckLeftHand
        // zero out the hand/count
        stz $1033,x
        stz $1034,x
        // jump forward to set the flag,
        // then return here to possibly
        // handle the left hand as well
        jsr $_SetSalvageFlag
    %CheckLeftHand:
        lda $1035,x
        cmp #$19
        bne $+DoneChecking
        // zero out the hand/count
        stz $1035,x
        stz $1036,x
    %SetSalvageFlag:
        // set the flag to salvage
        // the lost sword
        lda $_PostBattle__Flags
        ora #$02
        sta $_PostBattle__Flags
    %DoneChecking:
        rts

    SalvageLegendSword:
        // try to stuff Legend Sword in the inventory
        ldx #$0000
    %InventoryLoop:
        lda $1440,x
        bne $+InventoryNext
        lda #$19
        sta $1440,x
        lda #$01
        sta $1441,x
        rts
    %InventoryNext:
        inx
        inx
        cpx #$0060
        bcc $-InventoryLoop

        // if it didn't make it to the inventory, try to deliver as a battle item
        // we're only calling this function when there are no other spoils or
        // after we've already set spoils
        lda $06c6
        bne $+MIABSpoils
        ldx #$0000
    %SpoilsLoop:
        lda $1804,x
        bne $+SpoilsNext
    %FoundEmptySpoilsSlot:
        lda #$19
        sta $1804,x
        rts
    %SpoilsNext:
        inx
        cpx #$0007
        bcc $-SpoilsLoop
        // Override eighth item with Legend, it's important
        bra $-FoundEmptySpoilsSlot

    %MIABSpoils:
        // put the Legend Sword in the second spoils slot
        // and check it in Rewards__MIABContents
        lda #$19
        sta $1805
        rts
}

