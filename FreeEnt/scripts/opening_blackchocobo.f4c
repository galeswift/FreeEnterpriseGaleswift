event($10)  //Opening events
{
    vfx 0 // wipe out latent CHR data

    // Initial game state
    set #OpeningComplete
    set #DamcyanBombed
    set #ReinforcedEnterprise    

    // disable "free" spots with no free lunch flag
    // (Damcyan needs special case handling in damcyan.f4c)
    [#B #Rando_CheckFlag #randoflag.no_free_characters]
    [#B #If #Flag #flag.Result] {
        deactivate #fe_WateryPassTellah
        deactivate #Elder1
        set #TellahRejoined
    }

    // disable non-"free" spots with only free characters flag
    // all others disabled in their respective .f4c file
    [#B #Rando_CheckFlag #randoflag.no_earned_characters]
    [#B #If #Flag #flag.Result] {
        deactivate #Edge1
        set #FusoyaJoined
    }

    [#B #Rando_CheckFlag #randoflag.no_free_key_item]
    [#B #If #Flag #flag.Result] {
        set #SpokeToEdwardInToroia
    }

    // %testmode%
    [#B #TestMode_Startup]
    // %end%
    // %test_setting characters%
    [#B #DebugFillShadowParty]
    // %end%

    // %flag characters_cecil_paladin on%
    set #CecilBecamePaladin
    [#B #Rando_PaladinizeCecil]    
    // %end%

    // %flags: superhero_challenge%
    [#B #MakeSuperhero]
    // %end%

    // %quickstart%
    [#B #Rando_DeliverRewardFromSlot #reward_slot.starting_partner_character]
    [#B #Rando_DeliverRewardFromSlot #reward_slot.starting_item]
    [#B #GiveStarterKit]
    music #Prologue
    [#B #PutHovercraft 124 104]
    activate #BlackChocobo2
    load map #Overworld at 102 158 no transition
    player face down
    [#B #EndEvent]
    // %end%

    toggle music fade
    toggle screen fade

    consts(placement) {
        1   Soldier1
        2   Soldier2
        3   Soldier3
        8   Baigan
        7   Kain1
    }
    load map #BaronCastleLobby at 1 5 facing down
    player invisible
    batch 1 {
        player face down
        p #Soldier1 toggle visible
        p #Soldier2 toggle visible
        p #Soldier3 toggle visible
    }
    
    toggle screen fade
    pause 2
    player visible
    [#B #PlacementSetVisible 7]  // p #Kain1 toggle visible
    batch 5 {
        player move down
    }
    batch 7 {
        player move right
        p #Kain1 move left
    }
    p #Baigan toggle visible
    pause 4
    batch 1 {
        player face up
        p #Kain1 face up
        p #Baigan move down
    }
    batch 6 {
        p #Baigan move down
    }
    pause 2
    message $1D  // From the king
    [#B #Text_LoadRewardNameFromSlot #reward_slot.starting_item 0]
    sound #GetItem
    message #msg.fe_Received
    [#B #Objectives_TickRewardSlot #reward_slot.starting_item]
    [#B #Rando_DeliverRewardFromSlot #reward_slot.starting_item]

    // %starterkit0 message enable%
    sound #GetItem
    message $A1
    // %end%
    // %starterkit1 message enable%
    sound #GetItem
    message $A2
    // %end%
    // %starterkit2 message enable%
    sound #GetItem
    message $A3
    // %end%
    // %starterkit3 message enable%
    sound #GetItem
    message $A5
    // %end%
    // %starterkit4 message enable%
    sound #GetItem
    message $A6
    // %end%
    [#B #GiveStarterKit]

    pause 2
    batch 1 {
        player face right
        p #Kain1 face left
    }
    pause 2


    // Has partner flag
    set #Temp

    [#B #Rando_CheckFlag #randoflag.no_starting_partner]    
    [#B #If #Flag #flag.Result] {
        clear #Temp
    }

    [#B #If #Flag #flag.Temp]
    {
        [#B #Text_LoadRewardNameFromSlot #reward_slot.starting_partner_character 0]
        map message 6 // Let's go!

        // %flags: Cparty:1 ~Cpermajoin%
        p #Kain1 toggle visible
        // %end%

        //TODO: restore? [#B #Objectives_TickRewardSlot #reward_slot.starting_partner_character]
        [#B #Rando_DeliverRewardFromSlot #reward_slot.starting_partner_character]
        pause 2
    }

    // %debug init%
    // %end%

    [#B #If #Flag #flag.Temp]
    {
        batch 1 {
            player bow head
            p #Kain1 bow head
        }
        pause 2
        batch 1 {
            player face down
            p #Kain1 face down
        }
        // %if wacky_challenge_enabled%
        music #FatChocobo
        // %else%
        music #Prologue
        // %end%
        batch {
            player move down
            p #Kain1 move left
        }        
        batch 4 {
            player move down
            p #Kain1 move down
        }
    }

    [#B #If #not_Flag #flag.Temp]
    {
        player bow head
        pause 2
        player face down
        // %if wacky_challenge_enabled%
        music #FatChocobo
        // %else%
        music #Prologue
        // %end%
        batch 5 {
            player move down
        }
    }

    consts(placement) {
        3   BaronSoldier1
        4   BaronSoldier2
        5   CastleBaronSoldier1
        6   CastleBaronSoldier2
        11   Kain1
    }
    load map #BaronCastle at 15 16 facing down

    open door
    [#B #If #not_PartySize 1] {
        p #Kain1 toggle visible
    }
    batch 3 {
        p #CastleBaronSoldier1 face right
        p #CastleBaronSoldier2 face left
        player move down
        p #Kain1 move down
    }
    batch 7 {
        player move down
        p #Kain1 move down
    }
    batch 1 {
        p #BaronSoldier1 move left
        p #BaronSoldier2 move right
    }
    batch 1 {
        p #BaronSoldier1 face right
        p #BaronSoldier2 face left
    }
    p #BaronSoldier1 face up
    pause 4
    open door
    pause 4
    batch 1 {
        p #BaronSoldier1 face down
        p #BaronSoldier2 face down
    }
    batch 5 {
        player move down
        p #Kain1 move down
    }
    pause 6
    player wave in
    pause 16
    toggle screen fade

    vfx #Prologue

    [#B #PutHovercraft 124 104]
    load map #Overworld at 102 158
    sound #None

    // %if wacky_challenge_enabled%
    [#B #GotoEvent #event.fe_GuidingwayIntro]
    // %else%
    player visible
    toggle screen fade
    // %end%
}

placement($2A 7)  //#BaronCastleLobby
{
    // %kain1_slot npc1%
    npc #fe_DynamicNPC
    // %end%
}

npc(#Baigan) {
    sprite
        // %baigan_slot sprite main%
        #Captain
        // %end%
}

placement($2A 8)
{
    npc #Baigan
    position 8 2
    walking off
    tangible
    face down
    // %baigan_slot sprite main palette%
    palette 0
    // %end%
    turning off
    marching off
    speed 2
}

placement($24 11)  //#BaronCastle
{
    // %kain1_slot npc1%
    npc #fe_DynamicNPC
    // %end%
}

// start with Baron Black Chocobo
npc(#BlackChocobo2)
{
    default active
}

