// Mutually exclusive with Kain's magic,
// let's make Sight into a "Harm" spell that lets
// white mages do damage before White

// kainmagic and this flag should be mutually exclusive.
// use uispec and flagsetcore to handle that.

// Potential spell data for this fake Harm: 
// 0xE0 (0 ticks cast time, targetting like Virus)
// 0x19 (100 spell power)
// 0x64 (100 accuracy)
// 0x01 (damage plus sap; this effect explicitly checks for White/Crystal only)
// 0x85 (same as White)
// 0x0F (same MP cost as tier 2s, bounces off Walls)

// Change the name to "Harm"
text( spell name $17 ) {
[$40]Harm 
}

//spell($17) // #Harm
//{ 
//    casting time 0
//    target $07
//    param $19
//    hit 100
//    boss False
//    effect $01
//    damage False
//    element $05
//    impact True
//    mp cost 15
//    ignore wall False
//}
// there's no compiler for spell blocks, so just directly write the five non-MP/wall bytes, shrug
// the MP/wall byte, $0F, is handled by update_spells or wacky_rando
patch($0f982a bus) { E0 19 64 01 85 }

// set the audio effect for this spell to be the same as Ice1
patch($0fa366 bus) { 1D }

// set the visual effect for this spell to be Fire2, but with White palette 
// palette, tile-block, script, handler
patch($0fa0a8 bus) { 06 0B 06 00 }

// Let Cecil get it at level 17 (along with Porom, Rosa at 14 for utility);
// remove from Rydia's learned spells
// all changes happen in update_spells.py

// ensure that Harm only inflicts Sap on undead, like White
msfpatch{
    .addr $03d3e0
        jml $=DamageSap__CheckWhiteHarm
        nop nop

    .new
    DamageSap__CheckWhiteHarm:
        // still check for White
        cmp #$0b 
        beq $+IsWhiteHarm
        cmp #$17
        beq $+IsWhiteHarm
        jml $03d3f4
    %IsWhiteHarm:
        jml $03d3ed
}