// Add functionality for a third spellset for FuSoYa

// set the constant for Fu's Omni spellset, to improve code readability
consts(spellset) {
    $0e     FusoyaOmni
}

// Actually give Fu that spellset
patch($13fe06 bus) { 0E }
patch($14ffcb bus) { 0E }

// rename $15 to be "Omni"
consts(command)
{
    $15     Omni
}

// Add the menu data for "Omni" at the end of Bank 01,
// right before the Menu Kit extra code
patch($01fff0 bus) { F0 01 50 68 69 64 00 }

// Add a check to ensure the game actually reads
// the Omni data instead of Call in the menu
// similar to CharEx__MenuSpells_NinjaCheck
msfpatch {
    .addr $01afa2
        jml $=Fusoya__MenuSpells_OmniCheck
        nop

    .new 
    Fusoya__MenuSpells_OmniCheck:
        // first get the job value, like in NinjaCheck
        // but we need to mimic $019007 because we can't
        // jsl to it (no Bank01LongCall functionality)
        lda $01e8
        and #$0f
        asl a
        sta $43
        ldx $43
        rep #$20
        .mx 0x00
        lda $0fc625,x
        tax
        sep #$20
        .mx 0x20

        // now check for FuSoYa
        lda $0001,x
        and #$0f
        cmp #$0d
        bne $+NotOmni
        ldy #$fff0
    %NotOmni:
        jml $01afaa
}

// Add battle command name data for "Omni" in Bank 0F
patch($0fa82f bus) { 50 68 69 64 FF }

// Make the $15 command redirect to #Call (like #Ninja does)
msfpatch {
    .addr $02b9c1
        jml $=NinjaOmni__CommandRedirect

    .new
    NinjaOmni__CommandRedirect:
        // first do the displaced Ninja check
        cmp #$18
        bne $+CheckOmni
        jml $02ba29
    %CheckOmni:
        cmp #$15
        bne $+Done
        jml $02ba36
    %Done: 
        jml $02b9c5
}

// if not j-abilities, add the $15 command
// with j-abilities, the relevant f4c has a substitution
// %flag japanese_abilities off%
actor(#Fusoya) {
    commands {
        #Fight
        #White
        #Black
        #Omni
        #Item
    }
}
// %end%